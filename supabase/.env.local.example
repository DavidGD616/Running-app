# Local-only function environment for:
#   supabase functions serve adapt-plan --env-file supabase/.env.local
#
# Use the local anon key printed by `supabase status`.
SB_PUBLISHABLE_KEY=
# Do not use remote project URLs when running local-adaptive fixtures.
# Seed utility scripts in this repo intentionally reject non-local Supabase URLs.

# Required for live review generation. Not required for the preloaded pending
# review Maestro smoke path.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
